TZ=Europe/Berlin
BASE_URL=https://music.example.com
# Start the Navidrome that comes with Pocket Music. Remove this line (and run
# `docker compose stop navidrome`) to use your own music server at NAVIDROME_URL instead.
COMPOSE_PROFILES=navidrome
# Where your music is (default: music next to this file)
# MUSIC_FOLDER=/srv/music
# Your own Navidrome (or another Subsonic server):
# NAVIDROME_URL=http://navidrome:4533
# What a browser opens for "Open the server" (when NAVIDROME_URL is an internal address)
# NAVIDROME_PUBLIC_URL=https://navidrome.example.com
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# Your own Navidrome only — your account there (everyone else enters theirs under Settings → Library)
# NAVIDROME_USER=
# NAVIDROME_PASSWORD=
# LIDARR_URL=http://lidarr:8686
# LIDARR_API_KEY=
# MALOJA_URL=http://maloja:42010
# NOTIFY_URL=http://apprise:8000/notify/music
# OPENAI_API_KEY=
